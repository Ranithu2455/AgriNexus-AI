# --- Database ---
# Point this at the SAME database the other two modules use, so user IDs
# stay consistent across Module 2 (Marketplace) and Module 3 (Community).
DATABASE_URL=postgresql://agrinexus_user:changeme@localhost:5432/agrinexus_db

# --- Auth / JWT ---
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Weather (external API) ---
# Get a free key from https://openweathermap.org/api
WEATHER_API_KEY=your-openweathermap-api-key
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# --- AI Model Service ---
# Set to "mock" for development (no trained model required).
# Set to "tflite" or "torchserve" once a real model is trained and available.
DISEASE_MODEL_BACKEND=mock
PEST_MODEL_BACKEND=mock
DISEASE_MODEL_PATH=./models/disease_model.tflite
PEST_MODEL_PATH=./models/pest_model.tflite

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
UPLOAD_DIR=./uploads
